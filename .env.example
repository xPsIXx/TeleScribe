# === Required ===
TELEGRAM_BOT_TOKEN=your_bot_token_here

# === LLM (Chat Completion) ===
# OpenAI-compatible endpoint. Used on first boot to seed config.yaml.
# After that, change URL/model/temperature in the dashboard (Save & Reload).
# LLM_API_KEY is always read from the environment (never overwritten by YAML).
LLM_BASE_URL=http://localhost:8088/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen3.5-9b

# === Transcription (ASR) ===
# Seed values for the first run only. After config.yaml exists, the dashboard wins.
# Engines: local (faster-whisper), moonshine, parakeet
ASR_ENGINE=local
ASR_MODEL=distil-large-v3
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# ASR_LANGUAGE=en

# === Web Dashboard ===
# No login. Bind to localhost and put Traefik in front for public access.
WEB_HOST=0.0.0.0
WEB_PORT=8180

# === Bot Behavior (first-run seed; dashboard wins after save) ===
PRIVACY_MODE=true
LOG_LEVEL=INFO

# Data directory
DATA_DIR=/data
