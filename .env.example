# === Required ===
TELEGRAM_BOT_TOKEN=your_bot_token_here

# === LLM (Chat Completion) ===
# OpenAI-compatible endpoint. Supports Ollama, llama-swap, OpenAI, Groq, OpenRouter, etc.
LLM_BASE_URL=http://localhost:8088/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen3.5-9b

# === Transcription (ASR) Engine ===
# Options: local, moonshine, parakeet, openai, groq, custom
ASR_ENGINE=local
# ASR_ENGINE=moonshine
# ASR_ENGINE=parakeet
# ASR_ENGINE=groq
# ASR_ENGINE=custom
# ASR_ENGINE=openai

# For ASR_ENGINE=local — uses faster-whisper
# For ASR_ENGINE=moonshine — uses moonshine-voice (MIT, auto-downloads models)
# For ASR_ENGINE=parakeet — uses sherpa-onnx (NVIDIA Parakeet TDT, auto-downloads)
# Models (local): tiny, base, small, medium, large-v3, distil-large-v3, distil-medium.en
# Device: cpu, cuda
ASR_MODEL=distil-medium.en
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=en

# For ASR_ENGINE=custom — any OpenAI-compatible ASR endpoint
ASR_BASE_URL=
ASR_API_KEY=

# For ASR_ENGINE=openai
OPENAI_API_KEY=

# For ASR_ENGINE=groq
GROQ_API_KEY=

# === Web Dashboard ===
WEB_HOST=0.0.0.0
WEB_PORT=8180
WEB_USERNAME=admin
WEB_PASSWORD=changeme

# === Bot Behavior ===
ADMIN_USER_IDS=  # Comma-separated Telegram user IDs
AUTHORIZED_USERS=  # Comma-separated, or * for all

# Privacy mode: all bot replies visible only to the requesting user in groups
PRIVACY_MODE=true

# Data directory
DATA_DIR=/data
